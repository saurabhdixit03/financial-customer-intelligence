# Python virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]

# Environment variables / secrets
.env

# IDE / editor files
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Generated data
data/processed/*
data/rejected/*

# Keep directory structure in Git
!data/processed/.gitkeep
!data/rejected/.gitkeep